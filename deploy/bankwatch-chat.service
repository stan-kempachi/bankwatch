[Unit]
Description=BankWatch — assistant Discord (#budget, Claude Code, deux instances)
After=network-online.target bankwatch.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/apps/bankwatch
EnvironmentFile=/home/pi/apps/bankwatch/.env
Environment=PYTHONUNBUFFERED=1 TZ=Europe/Paris
ExecStart=/home/pi/apps/bankwatch/.venv/bin/python -m bankwatch.chat
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

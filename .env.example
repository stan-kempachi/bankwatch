# --- Fournisseur open banking
BW_PROVIDER=enablebanking

# --- Enable Banking (https://enablebanking.com/cp/applications) : app PRODUCTION en mode restreint
BW_EB_APP_ID=
BW_EB_KEY_PATH=data/enablebanking.pem
BW_EB_REDIRECT_URL=https://bankwatch.example.com/callback

# --- GoCardless (inscriptions fermées : uniquement pour un compte existant, avec BW_PROVIDER=gocardless)
# BW_GC_SECRET_ID=
# BW_GC_SECRET_KEY=

# --- Discord : via le bot (recommandé, comme les autres projets du Pi)
BW_DISCORD_CHANNEL_ID=
# le token est lu dans le .env partagé du bot (clé DISCORD_BOT_TOKEN), ou directement :
BW_DISCORD_TOKEN_FILE=/home/pi/discord_bridge/.env
# BW_DISCORD_BOT_TOKEN=
# --- ou via webhook (Paramètres du salon > Intégrations > Webhooks)
BW_DISCORD_WEBHOOK_URL=

# --- Dashboard : HTTP Basic obligatoire dès qu'il est exposé (sinon accès distant refusé)
BW_DASHBOARD_USER=stan
BW_DASHBOARD_PASSWORD=
# BW_DASHBOARD_MAX_FAILURES=10
# BW_DASHBOARD_LOCKOUT_MINUTES=15

# --- Stockage
BW_DB_PATH=data/bankwatch.db

# --- Seuils (valeurs par défaut, à ajuster après quelques semaines)
# BW_DUP_WINDOW_DAYS=3
# BW_DUP_MIN_AMOUNT=5
# BW_UNUSUAL_ZSCORE=3
# BW_NEW_MERCHANT_AMOUNT=150
# BW_BIG_AMOUNT=500
# BW_RECURRING_TOLERANCE_PCT=10
# BW_OVERSPEND_PCT=30
# BW_OVERSPEND_MIN_AMOUNT=100
# BW_WEEKLY_REPORT_WEEKDAY=0

# --- Ton nom dans les libellés : virements entre tes comptes = internes (hors dépenses)
# BW_OWNER_NAMES="prenom nom"

# --- Budgets mensuels par catégorie (optionnel, JSON)
# BW_BUDGETS={"courses": 400, "restos": 150, "shopping": 200}
